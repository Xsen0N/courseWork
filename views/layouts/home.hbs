<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/css/chat.css">
    <title>Главная страница</title>
<style>
    /* Основные стили */
    body {
        font-family: 'Roboto', sans-serif;
        margin: 0;
        padding: 0;
        background: linear-gradient(135deg, #f0f5ff 0%, #e6f0ff 25%, #f9f7ff 50%, #f5f0ff 75%, #f0f5ff 100%);
        background-size: 400% 400%;
        animation: gradientBG 20s ease infinite;
        color: #1a202c;
        line-height: 1.6;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    /* Заголовки секций */
    .section-header {
        text-align: center;
        padding: 40px 0 20px;
    }

    .section-header h1 {
        font-size: 2.5rem;
        color: #2d3748;
        margin-bottom: 15px;
    }

    .section-header h2 {
        font-size: 2rem;
        color: #2d3748;
        margin-bottom: 15px;
    }

    .section-header p {
        color: #4a5568;
        font-size: 1.1rem;
    }

    /* Типы мероприятий */
    .types-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .type-card {
        background: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
    }

    .type-card:hover {
        transform: translateY(-5px);
    }

    .type-card h3 {
        color: #2d3748;
        margin-bottom: 10px;
    }

    .type-card p {
        color: #4a5568;
    }

    /* Специалисты */
    .masters-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .master-card {
        background: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
    }

    .master-card:hover {
        transform: translateY(-5px);
    }

    .master-card h3 {
        color: #2d3748;
        margin-bottom: 10px;
    }

    .master-card p {
        color: #4a5568;
        margin-bottom: 15px;
    }

    .master-info {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        font-size: 0.9rem;
    }

    .master-price, .master-type {
        background: #f7fafc;
        padding: 5px 10px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .master-price i, .master-type i {
        color: #4a5568;
    }

    /* Анимации */
    @keyframes gradientBG {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    /* Адаптивность */
    @media (max-width: 768px) {
        .section-header h1 {
            font-size: 2rem;
        }

        .container {
            padding: 10px;
        }
    }

    /* Стили для фильтров */
    .filters-section {
        background: white;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 30px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .filters-title {
        font-size: 1.2rem;
        color: #2d3748;
        margin-bottom: 15px;
    }

    .filters-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }

    .filter-group {
        flex: 1;
        min-width: 250px;
    }

    .filter-group h4 {
        font-size: 1rem;
        color: #4a5568;
        margin-bottom: 10px;
    }

    .criteria-options {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .criteria-checkbox {
        display: none;
    }

    .criteria-label {
        display: inline-block;
        padding: 8px 16px;
        background: #f7fafc;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.9rem;
        color: #4a5568;
    }

    .criteria-checkbox:checked + .criteria-label {
        background: #4361ee;
        color: white;
        border-color: #4361ee;
    }

    .type-select {
        width: 100%;
        padding: 10px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 0.9rem;
        color: #4a5568;
        background-color: white;
    }

    .apply-filters {
        display: block;
        width: 100%;
        padding: 12px;
        background: #4361ee;
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 1rem;
        transition: background-color 0.3s ease;
        margin-top: 20px;
    }

    .apply-filters:hover {
        background: #3651d4;
    }

    .reset-filters {
        display: block;
        width: 100%;
        padding: 12px;
        background: #e2e8f0;
        color: #4a5568;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 1rem;
        transition: background-color 0.3s ease;
        margin-top: 10px;
    }

    .reset-filters:hover {
        background: #cbd5e0;
    }

    /* Анимация для карточек при фильтрации */
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .master-card {
        animation: fadeIn 0.5s ease forwards;
    }

    /* Индикатор загрузки */
    .loading {
        text-align: center;
        padding: 20px;
        display: none;
    }

    .loading i {
        font-size: 2rem;
        color: #4361ee;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
</style>
</head>

<body>
    {{> header}}

    <div class="container">
        <!-- Основной заголовок -->
        <div class="section-header">
            <h1>Платформа для подбора специалистов</h1>
            <p>Найдите профессионалов для вашего мероприятия</p>
        </div>

        <!-- Типы мероприятий -->
        <div class="section-header">
            <h2>Типы мероприятий</h2>
        </div>
        <div class="types-container">
            {{#each types}}
            <div class="type-card">
                <h3>{{TypeName}}</h3>
                <p>{{Description}}</p>
            </div>
            {{/each}}
        </div>

        <!-- Специалисты -->
        <div class="section-header">
            <h2>Наши специалисты</h2>
        </div>
        <div class="masters-container">
            {{#each masters}}
            <div class="master-card">
                <h3>{{Name}}</h3>
                <p>{{Description}}</p>
                <div class="master-info">
                    <div class="master-price">
                        <i class="fas fa-coins"></i> {{PriceForHour}} ₽/час
                    </div>
                    {{#if TypeName}}
                    <div class="master-type">
                        <i class="fas fa-calendar-alt"></i> {{TypeName}}
                    </div>
                    {{/if}}
                </div>
            </div>
            {{/each}}
        </div>
    </div>

    <script src="/js/chat.js"></script>
    <script>
        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey && e.altKey && e.key.toLowerCase() === 'a') {
                e.preventDefault();
                window.location.href = '/auth/registerAdmin';
            }
        });
    </script>
</body>

</html> 