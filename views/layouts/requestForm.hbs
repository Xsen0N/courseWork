<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Создание заявки</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Arial', sans-serif;
        }

        .container {
            max-width: 1000px;
            margin: 40px auto;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
        }

        .form-section {
            display: none;
            padding: 20px;
            background: white;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .form-section.active {
            display: block;
            animation: fadeIn 0.5s;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .step-indicator {
            display: flex;
            justify-content: space-between;
            margin: 2rem 0;
            position: relative;
        }

        .step-indicator::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 2px;
            background: #e9ecef;
            z-index: 1;
        }

        .step {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #e9ecef;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: #6c757d;
            position: relative;
            z-index: 2;
            transition: all 0.3s ease;
            border: 2px solid white;
        }

        .step.active {
            background: #0d6efd;
            color: white;
            box-shadow: 0 0 10px rgba(13, 110, 253, 0.3);
        }

        .card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
            border: none;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }

        .card-body {
            padding: 1.5rem;
        }

        .checkbox-group {
            background: white;
            border: 1px solid #dee2e6;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
            transition: all 0.3s ease;
        }

        .checkbox-group:hover {
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-color: #0d6efd;
        }

        .form-check-input {
            cursor: pointer;
        }

        .form-check-label {
            cursor: pointer;
            padding-left: 10px;
        }

        .quantity-input {
            background: #f8f9fa;
            padding: 10px;
            border-radius: 8px;
            margin-top: 10px;
        }

        .select2-container {
            width: 100% !important;
        }

        .select2-container .select2-selection--multiple {
            border-radius: 8px;
            border: 1px solid #dee2e6;
        }

        .btn {
            padding: 10px 25px;
            border-radius: 25px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: #0d6efd;
            border: none;
            box-shadow: 0 4px 6px rgba(13, 110, 253, 0.2);
        }

        .btn-primary:hover {
            background: #0b5ed7;
            transform: translateY(-2px);
            box-shadow: 0 6px 8px rgba(13, 110, 253, 0.3);
        }

        .btn-secondary {
            background: #6c757d;
            border: none;
            box-shadow: 0 4px 6px rgba(108, 117, 125, 0.2);
        }

        .btn-secondary:hover {
            background: #5c636a;
            transform: translateY(-2px);
        }

        .btn-success {
            background: #198754;
            border: none;
            box-shadow: 0 4px 6px rgba(25, 135, 84, 0.2);
        }

        .btn-success:hover {
            background: #157347;
            transform: translateY(-2px);
        }

        input[type="datetime-local"],
        select,
        textarea {
            border-radius: 8px !important;
            border: 1px solid #dee2e6 !important;
            padding: 10px 15px !important;
        }

        input[type="datetime-local"]:focus,
        select:focus,
        textarea:focus {
            border-color: #0d6efd !important;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
        }

        h1 {
            color: #2c3e50;
            margin-bottom: 30px;
            text-align: center;
            font-weight: bold;
        }

        h3 {
            color: #2c3e50;
            margin-bottom: 20px;
            font-weight: 600;
        }

        .text-muted {
            color: #6c757d !important;
        }

        @media (max-width: 768px) {
            .container {
                margin: 20px;
                padding: 20px;
            }

            .step {
                width: 35px;
                height: 35px;
                font-size: 14px;
            }
        }
    </style>
</head>
<body>
    {{> header}}
    <div class="container py-5">
        <h1>Создание новой заявки</h1>
        
        <div class="step-indicator">
            <div class="step active">1</div>
            <div class="step">2</div>
            <div class="step">3</div>
            <div class="step">4</div>
        </div>

        <form id="requestForm" action="/request/create" method="POST">
            <!-- Шаг 1: Выбор типа мероприятия -->
            <div class="form-section active">
                <h3><i class="fas fa-calendar-alt"></i> Тип мероприятия</h3>
                <div class="row">
                    {{#each types}}
                    <div class="col-md-4 mb-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">{{this.TypeName}}</h5>
                                <p class="card-text">{{this.Description}}</p>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="TypeId" value="{{this.TypeId}}" required>
                                    <label class="form-check-label">Выбрать</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>

            <!-- Шаг 2: Выбор специалистов -->
            <div class="form-section">
                <h3><i class="fas fa-users"></i> Требуемые специалисты</h3>
                <div class="row">
                    {{#each professions}}
                    <div class="col-md-6 mb-3">
                        <div class="checkbox-group">
                            <div class="form-check">
                                <input class="form-check-input profession-checkbox" 
                                       type="checkbox" 
                                       name="Professions" 
                                       value="{{this.ProfessionId}}" 
                                       id="prof{{this.ProfessionId}}">
                                <label class="form-check-label" for="prof{{this.ProfessionId}}">
                                    <strong>{{this.ProfessionName}}</strong>
                                    <p class="text-muted mb-2">{{this.Description}}</p>
                                </label>
                            </div>
                            <div class="quantity-input" style="display: none;">
                                <label>Количество специалистов:</label>
                                <input type="number" 
                                       name="Quantities[{{this.ProfessionId}}]" 
                                       min="1" 
                                       value="1" 
                                       class="form-control mt-1" 
                                       style="width: 100px;">
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>

            <!-- Шаг 3: Выбор критериев -->
            <div class="form-section">
                <h3><i class="fas fa-list-ul"></i> Критерии отбора</h3>
                <select class="form-select" name="Criterias" multiple="multiple">
                    {{#each criterias}}
                    <option value="{{this.CriteriasId}}">
                        {{this.Name}} - {{this.Description}}
                    </option>
                    {{/each}}
                </select>
            </div>

            <!-- Шаг 4: Детали мероприятия -->
            <div class="form-section">
                <h3><i class="fas fa-info-circle"></i> Детали мероприятия</h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Дата и время*</label>
                        <input type="datetime-local" 
                               class="form-control" 
                               name="Date" 
                               required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Место проведения*</label>
                        <select class="form-select" id="locationSelect" name="Location" required>
                            <option value="">Выберите город</option>
                            <option value="Минск">Минск</option>
                            <option value="Витебск">Витебск</option>
                            <option value="Гомель">Гомель</option>
                            <option value="Гродно">Гродно</option>
                            <option value="Могилев">Могилев</option>
                            <option value="Брест">Брест</option>
                            <option value="Иное">Иное</option>
                        </select>
                        <input type="text" class="form-control mt-2" id="otherLocationInput" name="OtherLocation" placeholder="Укажите место проведения" style="display: none;">
                    </div>
                    <div class="col-12">
                        <label class="form-label">Адрес*</label>
                        <input type="text" class="form-control" name="Address" required placeholder="Укажите полный адрес">
                    </div>
                    <div class="col-12">
                        <label class="form-label">Комментарии</label>
                        <textarea class="form-control" name="Comments" rows="3" placeholder="Дополнительная информация о мероприятии"></textarea>
                    </div>
                </div>
            </div>

            <!-- Навигация по шагам -->
            <div class="mt-4 d-flex justify-content-between">
                <button type="button" class="btn btn-secondary" id="prevBtn">
                    <i class="fas fa-arrow-left"></i> Назад
                </button>
                <button type="button" class="btn btn-primary" id="nextBtn">
                    Далее <i class="fas fa-arrow-right"></i>
                </button>
                <button type="submit" class="btn btn-success" id="submitBtn" style="display: none;">
                    <i class="fas fa-check"></i> Отправить
                </button>
            </div>
        </form>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            $('select[name="Criterias"]').select2({
                placeholder: "Выберите критерии",
                allowClear: true
            });

            let currentStep = 0;
            const steps = $('.form-section');
            
            $('#nextBtn').click(function() {
                if (validateStep(currentStep)) {
                    steps.eq(currentStep).removeClass('active');
                    currentStep++;
                    updateStepIndicator();
                    steps.eq(currentStep).addClass('active');
                    updateButtons();
                }
            });

            $('#prevBtn').click(function() {
                steps.eq(currentStep).removeClass('active');
                currentStep--;
                updateStepIndicator();
                steps.eq(currentStep).addClass('active');
                updateButtons();
            });

            // Обработка выбора места проведения
            $('#locationSelect').change(function() {
                if ($(this).val() === 'Иное') {
                    $('#otherLocationInput').show().attr('required', true);
                } else {
                    $('#otherLocationInput').hide().removeAttr('required');
                }
            });

            // Показать/скрыть поле ввода количества при выборе профессии
            $(document).on('change', '.profession-checkbox', function() {
                const container = $(this).closest('.checkbox-group');
                const quantityInput = container.find('.quantity-input');
                
                if ($(this).is(':checked')) {
                    quantityInput.slideDown();
                } else {
                    quantityInput.slideUp();
                    quantityInput.find('input').val('1');
                }
            });

            function validateStep(step) {
                return true;
            }

            function updateStepIndicator() {
                $('.step').removeClass('active').eq(currentStep).addClass('active');
            }

            function updateButtons() {
                $('#prevBtn').toggle(currentStep > 0);
                $('#nextBtn').toggle(currentStep < steps.length - 1);
                $('#submitBtn').toggle(currentStep === steps.length - 1);
            }

            // Обработка отправки формы
            $('#requestForm').on('submit', function(e) {
                e.preventDefault();
                
                const typeId = $('input[name="TypeId"]:checked').val();
                if (!typeId) {
                    alert('Пожалуйста, выберите тип мероприятия');
                    return;
                }

                const selectedProfessions = $('.profession-checkbox:checked');
                if (selectedProfessions.length === 0) {
                    alert('Пожалуйста, выберите хотя бы одну профессию');
                    return;
                }

                const formData = {
                    TypeId: typeId,
                    Date: $('input[name="Date"]').val(),
                    Location: $('#locationSelect').val(),
                    Address: $('input[name="Address"]').val().trim(),
                    Comments: $('textarea[name="Comments"]').val().trim(),
                    Professions: [],
                    Quantities: {},
                    Criterias: []
                };

                if (!formData.Date) {
                    alert('Пожалуйста, выберите дату и время');
                    return;
                }

                if (!formData.Location) {
                    alert('Пожалуйста, выберите место проведения');
                    return;
                }

                if (!formData.Address) {
                    alert('Пожалуйста, укажите адрес');
                    return;
                }

                if (formData.Location === 'Иное') {
                    const otherLocation = $('#otherLocationInput').val().trim();
                    if (!otherLocation) {
                        alert('Пожалуйста, укажите место проведения');
                        return;
                    }
                    formData.Location = otherLocation;
                }

                const selectedDate = new Date(formData.Date);
                if (isNaN(selectedDate.getTime())) {
                    alert('Пожалуйста, выберите корректную дату');
                    return;
                }

                const now = new Date();
                if (selectedDate < now) {
                    alert('Дата мероприятия не может быть в прошлом');
                    return;
                }

                selectedProfessions.each(function() {
                    const profId = $(this).val();
                    formData.Professions.push(profId);
                    const quantity = $(`input[name="Quantities[${profId}]"]`).val();
                    if (!quantity || parseInt(quantity) < 1) {
                        alert('Пожалуйста, укажите корректное количество специалистов');
                        return false;
                    }
                    formData.Quantities[profId] = quantity;
                });

                $('select[name="Criterias"] option:selected').each(function() {
                    formData.Criterias.push($(this).val());
                });

                $.ajax({
                    url: '/request/create',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function(response) {
                        if (response.success) {
                            alert('Заявка успешно создана!');
                            window.location.href = '/'; // Редирект на главную страницу
                        } else {
                            alert(response.message || 'Произошла ошибка при создании заявки');
                        }
                    },
                    error: function(xhr) {
                        console.error('Ошибка:', xhr.responseText);
                        const response = xhr.responseJSON;
                        alert(response?.message || 'Произошла ошибка при создании заявки');
                    }
                });
            });
        });
    </script>
</body>
</html>