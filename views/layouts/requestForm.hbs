<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Создание заявки</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
    <style>
        .form-section { display: none; }
        .form-section.active { display: block; }
        .step-indicator { 
            display: flex; 
            justify-content: space-between;
            margin: 2rem 0;
        }
        .step {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #ddd;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .step.active { background: #0d6efd; color: white; }
        .checkbox-group { margin: 1rem 0; }
        .select2-container { width: 100%!important; }
        #otherLocationInput { display: none; margin-top: 10px; }
    </style>
</head>
<body>
    <div class="container py-5">
        <h1 class="mb-4">Создание новой заявки</h1>
        
        <div class="step-indicator">
            <div class="step active">1</div>
            <div class="step">2</div>
            <div class="step">3</div>
            <div class="step">4</div>
        </div>

        <form id="requestForm" action="/request/create" method="POST">
            <!-- Шаг 1: Выбор типа мероприятия -->
            <div class="form-section active">
                <h3>Тип мероприятия</h3>
                <div class="row">
                    {{#each types}}
                    <div class="col-md-4 mb-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">{{this.TypeName}}</h5>
                                <p class="card-text">{{this.Description}}</p>
                                <input type="radio" name="type" value="{{this.TypeId}}" required>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>

            <!-- Шаг 2: Выбор специалистов -->
            <div class="form-section">
                <h3>Требуемые специалисты</h3>
                <div class="row">
                    {{#each professions}}
                    <div class="col-md-6 mb-3">
                        <div class="checkbox-group border p-3 rounded">
                            <div class="form-check">
                                <input class="form-check-input profession-checkbox" 
                                       type="checkbox" 
                                       name="professions[]" 
                                       value="{{this.ProfessionId}}" 
                                       id="prof{{this.ProfessionId}}">
                                <label class="form-check-label" for="prof{{this.ProfessionId}}">
                                    <strong>{{this.ProfessionName}}</strong>
                                    <p class="text-muted mb-2">{{this.Description}}</p>
                                </label>
                            </div>
                            <div class="quantity-input" style="display: none;">
                                <label>Количество специалистов:</label>
                                <input type="number" 
                                       name="quantities[{{this.ProfessionId}}]" 
                                       min="1" 
                                       value="1" 
                                       class="form-control mt-1" 
                                       style="width: 100px;">
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>

            <!-- Шаг 3: Выбор критериев -->
            <div class="form-section">
                <h3>Критерии отбора</h3>
                <select class="form-select" name="criterias" multiple="multiple">
                    {{#each criterias}}
                    <option value="{{this.CriteriasId}}">
                        {{this.Name}} - {{this.Description}}
                    </option>
                    {{/each}}
                </select>
            </div>

            <!-- Шаг 4: Детали мероприятия -->
            <div class="form-section">
                <h3>Детали мероприятия</h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Дата и время</label>
                        <input type="datetime-local" class="form-control" name="Date" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Место проведения</label>
                        <select class="form-select" id="locationSelect" name="Location" required>
                            <option value="">Выберите город</option>
                            <option value="Минск">Минск</option>
                            <option value="Витебск">Витебск</option>
                            <option value="Гомель">Гомель</option>
                            <option value="Гродно">Гродно</option>
                            <option value="Могилев">Могилев</option>
                            <option value="Брест">Брест</option>
                            <option value="Иное">Иное</option>
                        </select>
                        <input type="text" class="form-control mt-2" id="otherLocationInput" name="OtherLocation" placeholder="Укажите место проведения">
                    </div>
                    <div class="col-12">
                        <label class="form-label">Адрес</label>
                        <input type="text" class="form-control" name="Address">
                    </div>
                    <div class="col-12">
                        <label class="form-label">Комментарии</label>
                        <textarea class="form-control" name="Comments" rows="3" placeholder="Дополнительная информация о мероприятии"></textarea>
                    </div>
                </div>
            </div>

            <!-- Навигация по шагам -->
            <div class="mt-4">
                <button type="button" class="btn btn-secondary" id="prevBtn">Назад</button>
                <button type="button" class="btn btn-primary" id="nextBtn">Далее</button>
                <button type="submit" class="btn btn-success" id="submitBtn" style="display: none;">Отправить</button>
            </div>
        </form>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            $('select[name="criterias"]').select2({
                placeholder: "Выберите критерии",
                allowClear: true
            });

            let currentStep = 0;
            const steps = $('.form-section');
            
            $('#nextBtn').click(function() {
                if (validateStep(currentStep)) {
                    steps.eq(currentStep).removeClass('active');
                    currentStep++;
                    updateStepIndicator();
                    steps.eq(currentStep).addClass('active');
                    updateButtons();
                }
            });

            $('#prevBtn').click(function() {
                steps.eq(currentStep).removeClass('active');
                currentStep--;
                updateStepIndicator();
                steps.eq(currentStep).addClass('active');
                updateButtons();
            });

            // Обработка выбора места проведения
            $('#locationSelect').change(function() {
                if ($(this).val() === 'Иное') {
                    $('#otherLocationInput').show().attr('required', true);
                } else {
                    $('#otherLocationInput').hide().removeAttr('required');
                }
            });

            // Показать/скрыть поле ввода количества при выборе профессии
            $(document).on('change', '.profession-checkbox', function() {
                const container = $(this).closest('.checkbox-group');
                const quantityInput = container.find('.quantity-input');
                
                if ($(this).is(':checked')) {
                    quantityInput.slideDown();
                } else {
                    quantityInput.slideUp();
                }
            });

            function validateStep(step) {
                // Простая валидация - можно расширить
                return true;
            }

            function updateStepIndicator() {
                $('.step').removeClass('active').eq(currentStep).addClass('active');
            }

            function updateButtons() {
                $('#prevBtn').toggle(currentStep > 0);
                $('#nextBtn').toggle(currentStep < steps.length - 1);
                $('#submitBtn').toggle(currentStep === steps.length - 1);
            }
        });
    </script>
</body>
</html>