<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Детали мастера</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f0f0f0;
        }

        .container {
            max-width: 800px;
            margin: 20px auto;
            padding: 20px;
            background-color: #fff;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        .master {
            text-align: center;
            margin-bottom: 20px;
        }

        .master img {
            max-width: 300px;
            height: auto;
            border-radius: 50%;
            margin-bottom: 20px;
            border: 5px solid #fff;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        .master p {
            margin: 10px 0;
            font-size: 1.2em;
            color: #555;
        }

        .specialization {
            background-color: #e1f5fe;
            color: #0288d1;
            padding: 10px 20px;
            border-radius: 20px;
            display: inline-block;
            margin: 10px 0;
            font-weight: bold;
        }

        .description {
            text-align: left;
            padding: 20px;
            background-color: #f9f9f9;
            border-radius: 8px;
            margin: 20px 0;
        }

        .description h3 {
            color: #333;
            margin-bottom: 10px;
        }

        .price-info {
            background-color: #f5f5f5;
            padding: 15px;
            border-radius: 8px;
            margin-top: 20px;
            text-align: center;
        }

        .price {
            font-size: 1.5em;
            color: #2c3e50;
            font-weight: bold;
        }

        /* Стили для галереи */
        .gallery-section {
            margin: 30px 0;
        }
        
        .gallery-section h3 {
            text-align: center;
            color: #333;
            margin-bottom: 20px;
        }
        
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }
        
        .gallery-item {
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease;
        }
        
        .gallery-item:hover {
            transform: scale(1.03);
        }
        
        .gallery-item img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            display: block;
        }
    </style>
</head>

<body>
    {{> header}}
    <div class="container">
        <div class="master">
            {{#if master.Photo}}
            <img src="data:{{master.PhotoType}};base64,{{master.Photo}}" alt="{{master.Name}}" />
            {{else}}
            <img src="/images/default-avatar.png" alt="Default Avatar" />
            {{/if}}
            <h2>{{master.Name}}</h2>
            <div class="specialization">
                {{master.Profession.ProfessionName}}
            </div>
        </div>

        <div class="description">
            <h3>О специализации</h3>
            <p>{{master.Profession.Description}}</p>
        </div>

        <div class="description">
            <h3>О специалисте</h3>
            <p>{{master.Description}}</p>
        </div>

        {{#if gallery.length}}
        <div class="gallery-section">
            <h3>Примеры работ</h3>
            <div class="gallery-grid">
                {{#each gallery}}
                <div class="gallery-item">
                    <img src="data:{{this.PhotoType}};base64,{{this.Photo}}" alt="Пример работы {{../master.Name}}">
                </div>
                {{/each}}
            </div>
        </div>
        {{/if}}

        <div class="price-info">
            <h3>Стоимость услуг</h3>
            <div class="price">{{master.PriceForHour}} BYN / час</div>
        </div>
    </div>
</body>

</html>