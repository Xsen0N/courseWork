<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title text-danger">Ошибка</h2>
                    <p class="card-text">{{message}}</p>
                    {{#if error}}
                    <pre class="bg-light p-3 mt-3">{{error}}</pre>
                    {{/if}}
                    <a href="/" class="btn btn-primary mt-3">Вернуться на главную</a>
                </div>
            </div>
        </div>
    </div>
</div> 